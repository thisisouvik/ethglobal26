// This is your Prisma schema file
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Course {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  slug        String   @unique
  title       String
  subtitle    String
  description String
  longDesc    String?
  priceUsdt   Decimal  @db.Decimal(10, 2)
  image       String
  category    String
  tags        String[]
  instructor  String
  instructorTitle String?
  duration    String   // e.g. "12 hours"
  lessons     Int
  level       String   // Beginner / Intermediate / Advanced
  featured    Boolean  @default(false)
  published   Boolean  @default(true)
  rating      Decimal  @default(4.5) @db.Decimal(3, 1)
  reviewCount Int      @default(0)

  // Full course content lives in the DB — the app never falls back to static data.
  curriculum  Json?    // [{ section: string, lessons: string[] }]
  includes    String[]

  orders      Order[]
}

model Order {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Customer
  email     String
  name      String

  // Course
  courseId    String
  courseName  String
  priceUsdt   Decimal @db.Decimal(10, 2)

  // Payment
  status        OrderStatus @default(PENDING)
  paymentTxHash String?
  paymentAddr   String?
  webhookData   Json?

  // StableGate gateway (non-custodial USDT payment gateway on Whitechain)
  gatewayIntentId    String? @unique // pi_…
  gatewayPaymentId   String? @unique // pay_… (needed for refunds)
  gatewayStatus      String? // intent state machine: requires_authorization → … → succeeded
  gatewayCheckoutUrl String? // hosted checkout /c/<intentId>
  gatewayRefundId    String? // re_…
  refundStatus       String? // requested → authorized → submitted → succeeded | failed
  refundMode         String? // router | manual

  // Delivery
  downloadUrl String?
  deliveredAt DateTime?

  course Course @relation(fields: [courseId], references: [id])

  @@index([email])
  @@index([status])
  @@index([courseId])
}

enum OrderStatus {
  PENDING
  PAID
  DELIVERED
  FAILED
  REFUNDED
}

// Dedupe of StableGate webhook events (gateway retries with backoff, key = event id)
model StableGateEvent {
  id         String   @id // evt_…
  type       String
  receivedAt DateTime @default(now())
  payload    Json?
}
