# ─── Database (NeonDB) ───────────────────────────────────────────────
# Get these from https://console.neon.tech → your project → Connection Details
# DATABASE_URL should use the POOLED endpoint (-pooler) for the app runtime;
# DIRECT_URL uses the direct endpoint for migrations / db push.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require&connect_timeout=15&pool_timeout=10&connection_limit=5"
DIRECT_URL="postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require"

# ─── App ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── StableGate Payment Gateway (primary) ────────────────────────────
# Docs: gateway-docs/docs/05-API-AND-SDK.md
# API base URL of the StableGate gateway (dev default below)
STABLEGATE_API_URL="http://localhost:4000"
# Merchant secret key (sk_test_…) from the StableGate dashboard → /developers.
# When unset, checkout falls back to the legacy manual-transfer flow.
STABLEGATE_SECRET_KEY="sk_test_replace_me"
# Webhook signing secret used to verify StableGate-Signature headers.
# Register https://<your-app>/api/webhooks/stablegate in the gateway dashboard.
STABLEGATE_WEBHOOK_SECRET="whsec_replace_me"
# Per-call USDT price for the agent x402 endpoint (/api/agent/courses)
STABLEGATE_X402_PRICE="0.01"

# ─── WhiteChain manual-transfer fallback (legacy) ────────────────────
# Used only when the StableGate gateway is unreachable/unconfigured
WHITECHAIN_WALLET_ADDRESS="0xYourUSDTWalletAddressHere"
WHITECHAIN_WEBHOOK_SECRET="your_webhook_secret_here"
WHITECHAIN_API_URL="https://api.whitechain.io"

# ─── Admin Dashboard ─────────────────────────────────────────────────
# Simple password to protect /dashboard (change this!)
ADMIN_SECRET="change_this_admin_password_123"

# ─── Digital Product ─────────────────────────────────────────────────
# URL sent to customers after successful payment
PRODUCT_DOWNLOAD_URL="https://your-download-link.com/product"
